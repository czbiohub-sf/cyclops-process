// Required settings have no built-in defaults: this pipeline must never fall back
// to somebody else's storage. Supply them in the shell env or as params.
def required = { String name, value ->
    if (!value) {
        throw new IllegalStateException(
            "${name} is not set. Export ${name} (or pass the matching --param) before " +
            "running — the pipeline ships no site-specific storage defaults.")
    }
    return value.toString()
}

def opsOutputBase = required("OPS_OUTPUT_BASE_DIR",
    params.output_base_dir ?: System.getenv("OPS_OUTPUT_BASE_DIR"))
def opsConfigsDir = required("OPS_CONFIGS_DIR", System.getenv("OPS_CONFIGS_DIR"))
def opsExperiment = required("OPS_EXPERIMENT", params.experiment)

env {
    // params.output_base_dir is the single source of truth (also used by the GPU
    // telemetry beforeScript below), then the shell env.
    OPS_OUTPUT_BASE_DIR = opsOutputBase
    OPS_CONFIGS_DIR     = opsConfigsDir
    // OPS_EXP_CONFIG_FILE auto-tracks the experiment under the configs dir.
    OPS_EXP_CONFIG_FILE = System.getenv("OPS_EXP_CONFIG_FILE") ?: "${opsConfigsDir}/experiment_configs/${opsExperiment}_config.yaml"
    OPS_MONOREPO_ROOT   = required("OPS_MONOREPO_ROOT", System.getenv("OPS_MONOREPO_ROOT"))
    OPS_EXPERIMENT      = opsExperiment
    // CuPy (cupy-cuda12x) JIT-compiles some kernels (e.g. cupyx affine_transform) and
    // needs the CUDA toolkit. Set CUDA_PATH to a CUDA 12.6 toolkit matching the bundled
    // runtime; left empty, CuPy falls back to its own detection.
    CUDA_PATH           = System.getenv("CUDA_PATH") ?: ""
}

params {
    process_executors = [:]
    // beforeScript = """
    // source ${System.getenv("OPS_MONOREPO_ROOT")}/.venv/bin/activate
    // """
}

process {
    // errorStrategy 'finish': on a task failure, let already-RUNNING tasks finish
    // (don't kill them) and stop launching new ones; then `-resume`. Avoids wasting
    // the in-flight reconstruct fan-out when a late stage (e.g. VS) fails. Reference-run
    // policy added 2026-06-11; revert to default 'terminate' for production if undesired.
    errorStrategy = 'finish'

    // cache 'lenient': hash task inputs by name+size only, ignoring last-modified time.
    // Our processes orchestrate over external state via empty `.done` markers that are
    // re-`touch`ed every run, so the default (mtime-sensitive) cache treats a re-run
    // step's marker as "changed" and cascades re-runs down the chain on `-resume`.
    // Lenient is Nextflow's recommended mode for shared/network filesystems (we're on
    // NFS): the empty, identically-named markers then hash stably across runs, so a
    // re-run stops spuriously invalidating already-completed downstream stages.
    cache = 'lenient'

    // OPS_TELEMETRY_DIR is not sourced from the env {} block here because Nextflow executes
    // beforeScript before env {} exports in the generated .command.run. The dynamic path is
    // built via Groovy interpolation at launch time (using OPS_OUTPUT_BASE_DIR from the shell
    // env and params.experiment from the YAML), so no runtime ordering dependency exists.
    // OPS_TELEMETRY_DIR can still be set explicitly to override; otherwise it is derived
    // from the required output base and experiment resolved above.
    beforeScript = """
    if nvidia-smi -L &>/dev/null; then
        _tel_dir=\${OPS_TELEMETRY_DIR:-${opsOutputBase.replaceAll('/+$', '')}/${opsExperiment}/logs/telemetry/gpu}
        mkdir -p "\$_tel_dir"
        nvidia-smi -L > "\$_tel_dir/\${SLURM_JOB_ID}.log"
        nvidia-smi dmon -s u -d 5 -o DT >> "\$_tel_dir/\${SLURM_JOB_ID}.log" &
        echo \$! > .gpu_monitor.pid
    fi
    """
    afterScript = """
    if [ -f .gpu_monitor.pid ]; then
        kill \$(cat .gpu_monitor.pid) 2>/dev/null || true
        rm -f .gpu_monitor.pid
    fi
    """

    // GPU scheduling + CPU-bind, one place. A process that sets `ext.gpus` requests that
    // many GPUs plus the shared architecture constraint (params.gpu_constraint, which keeps
    // steps off the Blackwell/sm_120 node); `ext.gpu_constraint` overrides the constraint.
    // A process that sets `ext.cpu_bind_none` gets `--cpu-bind=none` to avoid non-contiguous
    // CPU-binding errors (ports the submitit `slurm_srun_args: ["--cpu-bind=none"]` used by
    // the ISS register/finalize jobs). Steps that set neither -> null (no extra options).
    clusterOptions = {
        def opts = []
        if (task.ext.cpu_bind_none) { 
            opts << "--cpu-bind=none" 
        }
        if (task.ext.gpus) {
            opts << "--gres=gpu:${task.ext.gpus}"
            def constraint = task.ext.gpu_constraint ?: params.gpu_constraint
            if (constraint) opts << "--constraint=\"${constraint}\""
        }
        opts ? opts.join(' ') : null
    }

    withLabel: cpu_large {
        cpus = 16
        memory = 400.GB
        time = 45.m  
        queue = 'cpu'
    }

    withName: convert_tiff_to_zarrv3 {
        executor = params.processes.convert_tiff_to_zarrv3.executor
        cpus = params.processes.convert_tiff_to_zarrv3.slurm_params.cpus
        memory = params.processes.convert_tiff_to_zarrv3.slurm_params.mem
        queue = params.processes.convert_tiff_to_zarrv3.slurm_params.slurm_partition
        ext.kwargs = params.processes.convert_tiff_to_zarrv3.python_kwargs
    }

    withName: stack_symlinks {
        executor = params.processes.stack_symlinks.executor
        cpus = params.processes.stack_symlinks.slurm_params.cpus
        memory = params.processes.stack_symlinks.slurm_params.mem
        queue = params.processes.stack_symlinks.slurm_params.slurm_partition
        ext.kwargs = params.processes.stack_symlinks.python_kwargs
    }

